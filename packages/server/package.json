{
  "name": "@floorfight/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "replay": "tsx src/replay.ts",
    "measure": "tsx scripts/measure.ts",
    "topdown": "tsx scripts/topdown.ts",
    "weapons": "tsx scripts/weapons.ts && tsx scripts/pattern.ts",
    "golden": "tsx test/replay.ts --golden"
  },
  "dependencies": {
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0",
    "tsx": "4.23.15",
    "tweetnacl": "1.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
