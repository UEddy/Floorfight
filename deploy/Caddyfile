# Floorfight front door. Caddy gets and renews the TLS certificate itself.
#
# The game server listens on 127.0.0.1:8080 only. Everything under /ws is
# proxied to it (Caddy upgrades WebSocket connections without extra config).
# Everything else is the built client, copied from packages/client/dist.

floorfight.duckdns.org {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	handle /ws* {
		reverse_proxy 127.0.0.1:8080
	}

	# Read only JSON and NFT images from the game server: open holders
	# matches, a match's state for the results screen, a wallet's NFTs and
	# their images. Same origin on purpose, so WebGL can draw an NFT image
	# without a cross origin request. The server rate limits each address
	# from the X-Forwarded-For Caddy sets here.
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	# Match logs, read only. These are the canonical logs the server hashed
	# and settled with, so anyone can download one and replay it:
	#
	#   npm run replay -- https://floorfight.duckdns.org/logs/12345.json
	#
	# There is nothing private in them. They are inputs, a roster of public
	# keys, the spread salt the server committed to before the round, and the
	# result. Browse is on so a match id is not needed to find one.
	handle_path /logs/* {
		root * /var/lib/floorfight/logs
		file_server browse
		header Content-Type application/json
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		root * /var/www/floorfight
		file_server
	}
}
